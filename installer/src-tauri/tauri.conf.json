{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MagNum-Setup",
  "version": "0.1.1",
  "identifier": "com.green.magnum.installer",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "نصب MagNum",
        "label": "main",
        "width": 460,
        "height": 500,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "center": true,
        "shadow": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": []
  }
}